# Godot
.godot/
/game/android/
*.translation

# Capture intermediates — clips are uploaded to object storage, not committed
/farm/out/
/farm/logs/
*.ogv

# Python bytecode. design/proto/creature_forge.py imports game/tools/pixelforge.py,
# which drops a __pycache__ inside game/ — build cruft, and `rm` is not available
# to the loop, so it has to be ignored rather than cleaned up.
__pycache__/
*.pyc

# Node / Next
node_modules/
.next/
.vercel/
out/

# Secrets
.env
.env.local
farm/.env

# macOS
.DS_Store
.vercel
.env*

# Build output. Vercel runs `node site/build.mjs` itself, so committing dist only
# adds five changed HTML files to every single tick's diff and makes the devlog's
# own diffstat meaningless.
site/dist/
