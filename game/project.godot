; Engine configuration file.
config_version=5

[application]

config/name="HD-2D Antfarm"
config/description="An autonomous HD-2D monster-tactics RPG, built in public."
run/main_scene="res://scenes/diorama.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[editor]

movie_writer/fps=30
movie_writer/disable_vsync=true
movie_writer/mjpeg_quality=0.9

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
